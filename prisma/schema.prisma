  jobCardServiceId Int            @map("job_card_service_id")
  statusId         Int?           @map("status_id")
  assignedUserId   Int            @map("assigned_user_id")
  assignedById     Int?           @map("assigned_by")
  bayId            Int?           @map("bay_id")
  assignedAt       DateTime       @default(dbgenerated("sysutcdatetime()")) @map("assigned_at")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  remarks          String?
  createdById      Int?           @map("created_by")
  modifiedById     Int?           @map("modified_by")
  createdAt        DateTime       @default(dbgenerated("sysutcdatetime()")) @map("created_at")
