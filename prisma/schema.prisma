  assignedUser     User           @relation("WorkAssignmentAssignedUser", fields: [assignedUserId], references: [id], onUpdate: NoAction)
  createdBy        User?          @relation("WorkAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobCard          JobCard        @relation(fields: [jobCardId], references: [id], onUpdate: NoAction)
  jobCardService   JobCardService @relation(fields: [jobCardServiceId], references: [id], onUpdate: NoAction)
  location         Location       @relation(fields: [locationId], references: [id], onUpdate: NoAction)
  modifiedBy       User?          @relation("WorkAssignmentModifiedBy", fields: [modifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           StatusMaster?  @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([locationId])
  @@index([jobCardId])
  @@index([jobCardServiceId])
  @@index([assignedUserId])
  @@index([statusId])
  @@index([bayId])
  @@map("work_assignments")
}

