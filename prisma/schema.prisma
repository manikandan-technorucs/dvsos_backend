model AuditLog {
  id                BigInt           @id @default(autoincrement())
  locationId        Int?             @map("location_id")
  tableName         String           @map("table_name") @db.NVarChar(250)
  recordId          BigInt           @map("record_id")
  actionType        String           @map("action_type") @db.NVarChar(50)
  performedByUserId Int              @map("performed_by_user_id")
  performedAt       DateTime         @default(dbgenerated("sysutcdatetime()")) @map("performed_at")
  recordName        String?          @map("record_name") @db.NVarChar(500)
  transactionId     String           @map("transaction_id") @db.UniqueIdentifier
