model JobCardServiceHistory {
  id               Int            @id @default(autoincrement())
  jobCardServiceId Int            @map("job_card_service_id")
  actionTypeId     Int            @map("action_type_id")
  fromStatusId     Int?           @map("from_status_id")
  toStatusId       Int            @map("to_status_id")
  changedById      Int            @map("changed_by")
  reason           String?        @db.NVarChar(500)
  createdAt        DateTime       @default(dbgenerated("sysutcdatetime()")) @map("created_at")
