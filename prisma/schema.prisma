  notifications         Notification[]
  processStageTrackings ProcessStageTracking[]

  @@index([locationId])
  @@index([statusId])
  @@index([entryType])
  @@index([customerId])
  @@index([vehicleId])
  @@index([enteredById])
  @@index([entryTime])
  @@map("gate_entries")
}

model ServiceCategory {
  id           Int           @id @default(autoincrement())
